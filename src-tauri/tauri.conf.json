{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EmuCleaner",
  "version": "0.1.0",
  "identifier": "com.emucleaner.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "EmuCleaner", "width": 1040, "height": 680, "minWidth": 900, "minHeight": 600 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Safe cleaner and booster for emulator gamers",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
